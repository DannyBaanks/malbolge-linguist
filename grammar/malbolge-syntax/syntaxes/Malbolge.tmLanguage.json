{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Malbolge",
  "scopeName": "source.malbolge",
  "fileTypes": ["malbolge"],
  "patterns": [
    {
      "name": "invalid.illegal.malbolge",
      "match": "[^\\x09\\x0A\\x0D\\x20-\\x7E]"
    },
    {
      "name": "constant.character.source.malbolge",
      "match": "[!-~]"
    }
  ]
}
