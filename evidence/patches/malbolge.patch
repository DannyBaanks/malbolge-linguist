 	path = vendor/grammars/mako-tmbundle
 	url = https://github.com/marconi/mako-tmbundle
+[submodule "vendor/grammars/malbolge-syntax"]
+	path = vendor/grammars/malbolge-syntax
+	url = https://github.com/DannyBaanks/malbolge-syntax.git
 [submodule "vendor/grammars/markdown-tm-language"]
 	path = vendor/grammars/markdown-tm-language
 	url = https://github.com/wooorm/markdown-tm-language.git
diff --git a/grammars.yml b/grammars.yml
index 3400fcec..6fbe2060 100644
--- a/grammars.yml
+++ b/grammars.yml
@@ -928,6 +928,8 @@ vendor/grammars/make.tmbundle:
 - source.makefile
 vendor/grammars/mako-tmbundle:
 - text.html.mako
+vendor/grammars/malbolge-syntax:
+- source.malbolge
 vendor/grammars/markdown-tm-language:
 - source.mdx
 - text.md
diff --git a/lib/linguist/languages.yml b/lib/linguist/languages.yml
index 5b18d2c9..0b632f23 100644
--- a/lib/linguist/languages.yml
+++ b/lib/linguist/languages.yml
@@ -4732,6 +4732,14 @@ Mako:
   tm_scope: text.html.mako
   ace_mode: text
   language_id: 221
+Malbolge:
+  type: programming
+  color: "#1D1A2F"
+  extensions:
+  - ".malbolge"
+  tm_scope: source.malbolge
+  ace_mode: text
+  language_id: 1006177966
 Markdown:
   type: prose
   color: "#083fa1"
