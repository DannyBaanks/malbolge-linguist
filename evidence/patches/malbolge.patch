 .gitmodules                                   |  3 ++
 grammars.yml                                  |  2 ++
 lib/linguist/languages.yml                    |  8 +++++
 samples/Malbolge/truth_machine.malbolge       |  1 +
 vendor/README.md                              |  1 +
 vendor/grammars/malbolge-syntax               |  1 +
 .../git_submodule/malbolge-syntax.dep.yml     | 33 +++++++++++++++++++
 7 files changed, 49 insertions(+)
 create mode 100644 samples/Malbolge/truth_machine.malbolge
 create mode 160000 vendor/grammars/malbolge-syntax
 create mode 100644 vendor/licenses/git_submodule/malbolge-syntax.dep.yml

diff --git a/.gitmodules b/.gitmodules
index 5d130a6d..4d8ec89b 100644
--- a/.gitmodules
+++ b/.gitmodules
@@ -977,6 +977,9 @@
